{% comment %}
  Renders a product page ingredient checker button.
{% endcomment %}

{% if product %}
  {{ 'skinin-ingredient-checker.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'skinin-ingredient-checker.js' | asset_url }}" defer></script>

  <style>
    #skinin-ingredient-checker-{{ block.id }} .skinin-check-button {
      -webkit-appearance: none !important;
      appearance: none !important;
      align-items: center !important;
      background: #1f2937 !important;
      border: 1px solid #1f2937 !important;
      border-radius: 6px !important;
      box-sizing: border-box !important;
      color: #ffffff !important;
      cursor: pointer !important;
      display: inline-flex !important;
      font: inherit !important;
      font-size: 15px !important;
      font-weight: 600 !important;
      justify-content: center !important;
      line-height: 1.2 !important;
      min-height: 44px !important;
      padding: 0 20px !important;
      text-decoration: none !important;
    }
    .skinin-modal-overlay {
      align-items: center !important;
      background: rgba(17, 24, 39, 0.58) !important;
      bottom: 0 !important;
      display: flex !important;
      justify-content: center !important;
      left: 0 !important;
      padding: 20px !important;
      position: fixed !important;
      right: 0 !important;
      top: 0 !important;
      z-index: 2147483000 !important;
    }
    .skinin-modal {
      background: #ffffff !important;
      border-radius: 12px !important;
      box-shadow: 0 24px 80px rgba(17, 24, 39, 0.28) !important;
      color: #111827 !important;
      display: flex !important;
      flex-direction: column !important;
      max-height: min(720px, 90vh) !important;
      max-width: 640px !important;
      overflow: hidden !important;
      width: 100% !important;
    }
    .skinin-modal-header {
      align-items: center !important;
      background: #111827 !important;
      color: #ffffff !important;
      display: flex !important;
      flex-shrink: 0 !important;
      justify-content: space-between !important;
      padding: 18px 20px !important;
    }
    .skinin-modal-header h2 {
      color: #ffffff !important;
      font-size: 18px !important;
      margin: 0 !important;
    }
    .skinin-modal-close {
      background: rgba(255, 255, 255, 0.15) !important;
      border: 0 !important;
      border-radius: 50% !important;
      color: #ffffff !important;
      cursor: pointer !important;
      font-size: 20px !important;
      height: 32px !important;
      width: 32px !important;
    }
    .skinin-summary,
    .skinin-modal-message {
      font-size: 14px !important;
      line-height: 1.45 !important;
      padding: 14px 20px !important;
    }
    .skinin-modal-body {
      flex: 1 !important;
      overflow-y: auto !important;
    }
    .skinin-modal-list {
      display: grid !important;
    }
    .skinin-modal-item {
      align-items: center !important;
      border-bottom: 1px solid #f3f4f6 !important;
      display: flex !important;
      gap: 16px !important;
      justify-content: space-between !important;
      padding: 14px 20px !important;
    }
    .skinin-modal-footer {
      flex-shrink: 0 !important;
    }
    .skinin-rating {
      border-radius: 999px !important;
      font-size: 11px !important;
      font-weight: 800 !important;
      padding: 6px 12px !important;
    }
  </style>

  <div
    id="skinin-ingredient-checker-{{ block.id }}"
    class="skinin-ingredient-checker"
    data-shop="{{ shop.permanent_domain | escape }}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-app-url="{{ block.settings.app_url | escape }}"
  >
    <script type="application/json" data-skinin-product>
      {
        "description": {{ product.description | strip_html | json }},
        "metafieldIngredients": {{ product.metafields.skinin.ingredients.value | default: product.metafields.custom.ingredients.value | json }}
      }
    </script>

    <button
      id="skinin-check-ingredients-button-{{ block.id }}"
      type="button"
      class="skinin-check-button"
      data-skinin-check-button
      aria-haspopup="dialog"
    >
      Check Ingredients
    </button>
  </div>

  <script>
    /* skinin-inline v1.0.5 */
    (function () {
      var root = document.getElementById("skinin-ingredient-checker-{{ block.id }}");
      if (!root || root.dataset.skininInlineBound === "true") return;
      root.dataset.skininInlineBound = "true";

      var button = root.querySelector("[data-skinin-check-button]");
      if (!button || button.dataset.skininBound === "true") return;

      console.log("[Skinin] theme extension loaded");
      button.dataset.skininBound = "true";

      var cfg = {
        buttonText: "Check Ingredients",
        buttonColor: "#1f2937",
        modalTitle: "Ingredient Check",
        labels: { safe: "Commonly used", caution: "Worth knowing about", avoid: "May cause sensitivity in some users" },
        disclaimerText: "Ingredient notes are based on the ingredient list in the product description and are for informational purposes only. Not medical advice."
      };

      loadSettings();

      function loadSettings() {
        var shop = root.dataset.shop;
        var appUrl = root.dataset.appUrl;
        if (!shop || !appUrl) return;
        var url;
        try { url = new URL("/api/settings", appUrl).toString() + "?shop=" + encodeURIComponent(shop); } catch (e) { return; }
        fetch(url)
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (data) {
            if (!data) return;
            if (data.buttonText) cfg.buttonText = data.buttonText;
            if (data.buttonColor) cfg.buttonColor = data.buttonColor;
            if (data.modalTitle) cfg.modalTitle = data.modalTitle;
            if (data.disclaimerText) cfg.disclaimerText = data.disclaimerText;
            if (data.labels) {
              if (data.labels.low) cfg.labels.safe = data.labels.low;
              if (data.labels.mid) cfg.labels.caution = data.labels.mid;
              if (data.labels.high) cfg.labels.avoid = data.labels.high;
            }
            if (!button.disabled) {
              button.textContent = cfg.buttonText;
              button.style.setProperty("background", cfg.buttonColor, "important");
              button.style.setProperty("border-color", cfg.buttonColor, "important");
            }
          })
          .catch(function () {});
      }

      button.addEventListener("click", function (event) {
        event.preventDefault();
        console.log("[Skinin] Check Ingredients clicked");

        var ingredients = readIngredients(root);
        console.log("[Skinin] ingredient list found: " + (ingredients.length > 0));

        if (!ingredients.length) {
          console.log("[Skinin] skipped analysis because no ingredient list was found");
          showModal(
            "No ingredient list found for this product.",
            "Add ingredients to the product description using this format: Ingredients: Water, Glycerin, Niacinamide, Panthenol, Fragrance"
          );
          return;
        }

        button.disabled = true;
        button.textContent = "Checking ingredients...";
        var statusLogged = false;
        console.log("[Skinin] calling analyze API");

        fetch(resolveAnalyzeUrl(root), {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            shop: root.dataset.shop,
            productId: root.dataset.productId,
            productTitle: root.dataset.productTitle,
            ingredients: ingredients
          })
        })
          .then(function (response) {
            console.log("[Skinin] analyze status: " + response.status);
            statusLogged = true;
            if (!response.ok) throw new Error("Ingredient check request failed (" + response.status + ")");
            return response.json();
          })
          .then(function (result) {
            console.log("[Skinin] response data:", result);
            showResults(result.ingredients || []);
          })
          .catch(function (error) {
            if (!statusLogged) console.log("[Skinin] analyze status: network_error");
            showModal("We couldn't check this product right now.", error.message || "Please try again in a moment.");
          })
          .finally(function () {
            button.disabled = false;
            button.textContent = cfg.buttonText;
          });
      });

      function resolveAnalyzeUrl(rootNode) {
        var appUrl = rootNode.dataset.appUrl;
        if (!appUrl) return "https://skinin-shopify-app.onrender.com/api/ingredients/analyze";
        try { return new URL("/api/ingredients/analyze", appUrl).toString(); } catch (e) { return "https://skinin-shopify-app.onrender.com/api/ingredients/analyze"; }
      }

      function readIngredients(rootNode) {
        var productScript = rootNode.querySelector("[data-skinin-product]");
        var productData = {};
        if (productScript) {
          try {
            productData = JSON.parse(productScript.textContent || "{}");
          } catch (error) {
            productData = {};
          }
        }

        if (Array.isArray(productData.metafieldIngredients)) {
          var metafieldArrayIngredients = cleanIngredients(productData.metafieldIngredients);
          return isPlausibleIngredientList(metafieldArrayIngredients) ? metafieldArrayIngredients : [];
        }

        if (productData.metafieldIngredients) {
          var metafieldIngredients = splitIngredients(productData.metafieldIngredients);
          return isPlausibleIngredientList(metafieldIngredients, productData.metafieldIngredients) ? metafieldIngredients : [];
        }

        var ingredientText = findIngredientText(productData.description || "");
        var ingredients = splitIngredients(ingredientText);
        return isPlausibleIngredientList(ingredients, ingredientText) ? ingredients : [];
      }

      function findIngredientText(text) {
        var labels = ["ingredients", "ingredient list", "inci", "full ingredients"];
        var sourceText = String(text || "");
        var lowerText = sourceText.toLowerCase();
        for (var i = 0; i < labels.length; i += 1) {
          var pattern = new RegExp("\\b" + escapeRegExp(labels[i]) + "\\b\\s*:", "i");
          var match = pattern.exec(sourceText);
          if (match) return trimIngredientSection(sourceText.slice(match.index + match[0].length));

          var index = lowerText.indexOf(labels[i] + ":");
          if (index >= 0) return trimIngredientSection(sourceText.slice(index + labels[i].length + 1));
        }
        return "";
      }

      function trimIngredientSection(value) {
        var sectionBreak = String(value).search(/\b(directions|usage|how to use|warnings?|caution|description|details|benefits|related products?|you may also like|sale)\b\s*:/i);
        var section = sectionBreak >= 0 ? String(value).slice(0, sectionBreak) : String(value);
        return section.replace(/^[:\s-]+/, "").trim();
      }

      function splitIngredients(value) {
        return cleanIngredients(String(value || "").split(/[,;\n]+/));
      }

      function isPlausibleIngredientList(ingredients, sourceText) {
        if (!Array.isArray(ingredients) || ingredients.length < 2) return false;
        if (sourceText && String(sourceText).indexOf(",") < 0) return false;

        var plausibleCount = ingredients.filter(function (ingredient) {
          return isPlausibleIngredientName(ingredient);
        }).length;
        return plausibleCount >= 2 && plausibleCount / ingredients.length >= 0.7;
      }

      function isPlausibleIngredientName(value) {
        var ingredient = String(value || "").trim().replace(/[.,;:]+$/g, "").trim();
        if (!/[a-z]/i.test(ingredient)) return false;
        if (ingredient.length < 2 || ingredient.length > 80) return false;
        if (/[+$€£¥₩]|(?:\d+%?\s*off)|(?:\$\s*\d+)/i.test(ingredient)) return false;
        if (/\b(add to cart|buy now|sale|sold out|related products?|you may also like|shipping|returns?|reviews?|price|subtotal|checkout|home|menu)\b/i.test(ingredient)) return false;
        return true;
      }

      function cleanIngredients(values) {
        return values.map(function (value) {
          return String(value).trim().replace(/[.,;:]+$/g, "").trim();
        }).filter(Boolean).slice(0, 80);
      }

      function escapeRegExp(value) {
        return String(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      }

      function showResults(ingredients) {
        var body = ingredients.length
          ? ingredients.map(function (ingredient) {
              var rating = ingredient.safetyRating || "caution";
              var ratingLabel = cfg.labels[rating] || rating;
              var reasonText = ingredient.reason || "";
              var toggleAndDetail = reasonText
                ? "<button type=\"button\" class=\"skinin-toggle\" aria-label=\"Show details\" aria-expanded=\"false\">▼ Details</button>"
                  + "<div class=\"skinin-detail\" style=\"display:none;\"><p class=\"skinin-detail-text\">" + escapeHtml(reasonText) + "</p></div>"
                : "";
              return "<article class=\"skinin-modal-item\">"
                + "<div class=\"skinin-item-info\">"
                  + "<div class=\"skinin-item-name\">"
                    + "<h3>" + escapeHtml(ingredient.name || "Ingredient") + "</h3>"
                  + "</div>"
                  + "<p class=\"skinin-function\">" + escapeHtml(ingredient.category || ingredient.function || "cosmetic ingredient") + "</p>"
                  + toggleAndDetail
                + "</div>"
                + "<div class=\"skinin-item-right\">"
                  + "<span class=\"skinin-rating skinin-rating-" + escapeHtml(rating) + "\">" + escapeHtml(ratingLabel) + "</span>"
                + "</div>"
              + "</article>";
            }).join("")
          : "<div class=\"skinin-modal-message\">No ingredient results returned.</div>";
        showModal(cfg.modalTitle, body, true);
      }

      function showModal(title, body, bodyIsHtml) {
        var existing = document.querySelector(".skinin-modal-overlay");
        if (existing) existing.remove();

        var overlay = document.createElement("div");
        overlay.className = "skinin-modal-overlay";
        overlay.innerHTML = "<div class=\"skinin-modal\" role=\"dialog\" aria-modal=\"true\"><div class=\"skinin-modal-header\"><h2>" + escapeHtml(title) + "</h2><button type=\"button\" class=\"skinin-modal-close\" aria-label=\"Close\">&times;</button></div><div class=\"skinin-modal-body\"><div class=\"skinin-summary skinin-summary-neutral\">" + escapeHtml(title) + "</div>" + (bodyIsHtml ? "<div class=\"skinin-modal-list\">" + body + "</div>" : "<div class=\"skinin-modal-message\">" + escapeHtml(body) + "</div>") + "</div><div class=\"skinin-modal-footer\">" + escapeHtml(cfg.disclaimerText) + "</div></div>";
        overlay.addEventListener("click", function (event) {
          var toggle = event.target.closest && event.target.closest(".skinin-toggle");
          if (toggle) {
            var item = toggle.closest(".skinin-modal-item");
            var detail = item && item.querySelector(".skinin-detail");
            if (detail) {
              var isOpen = detail.style.display === "block";
              detail.style.display = isOpen ? "none" : "block";
              toggle.textContent = isOpen ? "▼" : "▲";
              toggle.setAttribute("aria-label", isOpen ? "Show details" : "Hide details");
              toggle.setAttribute("aria-expanded", isOpen ? "false" : "true");
            }
            return;
          }
          if (event.target === overlay || event.target.closest(".skinin-modal-close")) overlay.remove();
        });
        document.body.appendChild(overlay);
      }

      function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, function (character) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" }[character];
        });
      }
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Ingredient checker",
  "target": "section",
  "stylesheet": "skinin-ingredient-checker.css",
  "javascript": "skinin-ingredient-checker.js",
  "settings": [
    {
      "type": "url",
      "id": "app_url",
      "label": "App backend URL"
    }
  ]
}
{% endschema %}
