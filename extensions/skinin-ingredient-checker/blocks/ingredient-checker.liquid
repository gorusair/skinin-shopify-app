{% comment %}
  Renders a product page ingredient checker button.
{% endcomment %}

{% if product %}
  {{ 'skinin-ingredient-checker.css' | asset_url | stylesheet_tag }}
  {{ 'skinin-ingredient-checker.js' | asset_url | script_tag }}

  <div
    id="skinin-ingredient-checker-{{ block.id }}"
    class="skinin-ingredient-checker"
    data-shop="{{ shop.permanent_domain | escape }}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-app-url="{{ block.settings.app_url | escape }}"
  >
    <script type="application/json" data-skinin-product>
      {
        "description": {{ product.description | strip_html | json }},
        "metafieldIngredients": {{ product.metafields.skinin.ingredients.value | default: product.metafields.custom.ingredients.value | json }}
      }
    </script>

    <button
      id="skinin-check-ingredients-button-{{ block.id }}"
      type="button"
      class="skinin-check-button"
      data-skinin-check-button
      aria-haspopup="dialog"
    >
      Check Ingredients
    </button>
  </div>
{% endif %}

{% schema %}
{
  "name": "Ingredient checker",
  "target": "section",
  "stylesheet": "skinin-ingredient-checker.css",
  "javascript": "skinin-ingredient-checker.js",
  "settings": [
    {
      "type": "url",
      "id": "app_url",
      "label": "App backend URL"
    }
  ]
}
{% endschema %}
