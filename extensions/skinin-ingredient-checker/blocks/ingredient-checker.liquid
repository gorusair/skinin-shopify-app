{% comment %}
  Renders a product page ingredient checker button.
{% endcomment %}

{% if product %}
  {{ 'skinin-ingredient-checker.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'skinin-ingredient-checker.js' | asset_url }}" defer></script>

  <style>
    #skinin-ingredient-checker-{{ block.id }} .skinin-check-button {
      -webkit-appearance: none !important;
      appearance: none !important;
      align-items: center !important;
      background: #1f2937 !important;
      border: 1px solid #1f2937 !important;
      border-radius: 6px !important;
      box-sizing: border-box !important;
      color: #ffffff !important;
      cursor: pointer !important;
      display: inline-flex !important;
      font: inherit !important;
      font-size: 15px !important;
      font-weight: 600 !important;
      justify-content: center !important;
      line-height: 1.2 !important;
      min-height: 44px !important;
      padding: 0 20px !important;
      text-decoration: none !important;
    }
    .skinin-modal-overlay {
      align-items: center !important;
      background: rgba(17, 24, 39, 0.58) !important;
      bottom: 0 !important;
      display: flex !important;
      justify-content: center !important;
      left: 0 !important;
      padding: 20px !important;
      position: fixed !important;
      right: 0 !important;
      top: 0 !important;
      z-index: 2147483000 !important;
    }
    .skinin-modal {
      background: #ffffff !important;
      border-radius: 12px !important;
      box-shadow: 0 24px 80px rgba(17, 24, 39, 0.28) !important;
      color: #111827 !important;
      max-height: min(720px, 90vh) !important;
      max-width: 640px !important;
      overflow: hidden !important;
      width: 100% !important;
    }
    .skinin-modal-header {
      align-items: center !important;
      background: #111827 !important;
      color: #ffffff !important;
      display: flex !important;
      justify-content: space-between !important;
      padding: 18px 20px !important;
    }
    .skinin-modal-header h2 {
      color: #ffffff !important;
      font-size: 18px !important;
      margin: 0 !important;
    }
    .skinin-modal-close {
      background: rgba(255, 255, 255, 0.15) !important;
      border: 0 !important;
      border-radius: 50% !important;
      color: #ffffff !important;
      cursor: pointer !important;
      font-size: 20px !important;
      height: 32px !important;
      width: 32px !important;
    }
    .skinin-summary,
    .skinin-modal-message {
      font-size: 14px !important;
      line-height: 1.45 !important;
      padding: 14px 20px !important;
    }
    .skinin-modal-list {
      max-height: calc(90vh - 130px) !important;
      overflow: auto !important;
    }
    .skinin-modal-item {
      align-items: center !important;
      border-bottom: 1px solid #f3f4f6 !important;
      display: flex !important;
      gap: 16px !important;
      justify-content: space-between !important;
      padding: 14px 20px !important;
    }
    .skinin-rating {
      border-radius: 999px !important;
      font-size: 11px !important;
      font-weight: 800 !important;
      padding: 6px 12px !important;
    }
  </style>

  <div
    id="skinin-ingredient-checker-{{ block.id }}"
    class="skinin-ingredient-checker"
    data-shop="{{ shop.permanent_domain | escape }}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-app-url="{{ block.settings.app_url | escape }}"
  >
    <script type="application/json" data-skinin-product>
      {
        "description": {{ product.description | strip_html | json }},
        "metafieldIngredients": {{ product.metafields.skinin.ingredients.value | default: product.metafields.custom.ingredients.value | json }}
      }
    </script>

    <button
      id="skinin-check-ingredients-button-{{ block.id }}"
      type="button"
      class="skinin-check-button"
      data-skinin-check-button
      aria-haspopup="dialog"
    >
      Check Ingredients
    </button>
  </div>

  <script>
    (function () {
      var root = document.getElementById("skinin-ingredient-checker-{{ block.id }}");
      if (!root || root.dataset.skininInlineBound === "true") return;
      root.dataset.skininInlineBound = "true";

      var button = root.querySelector("[data-skinin-check-button]");
      if (!button || button.dataset.skininBound === "true") return;

      console.log("[Skinin] theme extension loaded");
      button.dataset.skininBound = "true";

      button.addEventListener("click", function (event) {
        event.preventDefault();
        console.log("[Skinin] Check Ingredients clicked");

        var ingredients = readIngredients(root);
        console.log("[Skinin] ingredients text found: " + (ingredients.length > 0));

        if (!ingredients.length) {
          showModal("No ingredient data found.", "Add ingredients to the product description to run a check.");
          return;
        }

        button.disabled = true;
        button.textContent = "Checking ingredients...";
        var statusLogged = false;
        console.log("[Skinin] calling analyze API");

        fetch(resolveAnalyzeUrl(root), {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            shop: root.dataset.shop,
            productId: root.dataset.productId,
            productTitle: root.dataset.productTitle,
            ingredients: ingredients
          })
        })
          .then(function (response) {
            console.log("[Skinin] analyze status: " + response.status);
            statusLogged = true;
            if (!response.ok) throw new Error("Ingredient check request failed (" + response.status + ")");
            return response.json();
          })
          .then(function (result) {
            showResults(result.ingredients || []);
          })
          .catch(function (error) {
            if (!statusLogged) console.log("[Skinin] analyze status: network_error");
            showModal("We couldn't check this product right now.", error.message || "Please try again in a moment.");
          })
          .finally(function () {
            button.disabled = false;
            button.textContent = "Check Ingredients";
          });
      });

      function resolveAnalyzeUrl(rootNode) {
        try {
          return new URL("/api/ingredients/analyze", rootNode.dataset.appUrl || window.location.origin).toString();
        } catch (error) {
          return "/api/ingredients/analyze";
        }
      }

      function readIngredients(rootNode) {
        var productScript = rootNode.querySelector("[data-skinin-product]");
        var productData = {};
        if (productScript) {
          try {
            productData = JSON.parse(productScript.textContent || "{}");
          } catch (error) {
            productData = {};
          }
        }

        if (Array.isArray(productData.metafieldIngredients)) {
          return cleanIngredients(productData.metafieldIngredients);
        }

        if (productData.metafieldIngredients) {
          return splitIngredients(productData.metafieldIngredients);
        }

        return splitIngredients(findIngredientText(productData.description || document.body.innerText || ""));
      }

      function findIngredientText(text) {
        var labels = ["ingredients", "ingredient list", "inci", "full ingredients"];
        var lowerText = String(text).toLowerCase();
        for (var i = 0; i < labels.length; i += 1) {
          var index = lowerText.indexOf(labels[i]);
          if (index >= 0) return String(text).slice(index + labels[i].length).replace(/^[:\s-]+/, "");
        }
        return "";
      }

      function splitIngredients(value) {
        return cleanIngredients(String(value || "").split(/[,;\n]+/));
      }

      function cleanIngredients(values) {
        return values.map(function (value) {
          return String(value).trim().replace(/[.,;:]+$/g, "").trim();
        }).filter(Boolean).slice(0, 80);
      }

      function showResults(ingredients) {
        var body = ingredients.length
          ? ingredients.map(function (ingredient) {
              return "<article class=\"skinin-modal-item\"><div class=\"skinin-item-info\"><h3>" + escapeHtml(ingredient.name || "Ingredient") + "</h3><p class=\"skinin-function\">" + escapeHtml(ingredient.function || "cosmetic ingredient") + "</p></div><span class=\"skinin-rating skinin-rating-" + escapeHtml(ingredient.safetyRating || "caution") + "\">" + escapeHtml((ingredient.safetyRating || "caution").toUpperCase()) + "</span></article>";
            }).join("")
          : "<div class=\"skinin-modal-message\">No ingredient results returned.</div>";
        showModal("Ingredient Check", body, true);
      }

      function showModal(title, body, bodyIsHtml) {
        var existing = document.querySelector(".skinin-modal-overlay");
        if (existing) existing.remove();

        var overlay = document.createElement("div");
        overlay.className = "skinin-modal-overlay";
        overlay.innerHTML = "<div class=\"skinin-modal\" role=\"dialog\" aria-modal=\"true\"><div class=\"skinin-modal-header\"><h2>" + escapeHtml(title) + "</h2><button type=\"button\" class=\"skinin-modal-close\" aria-label=\"Close\">&times;</button></div><div class=\"skinin-summary skinin-summary-neutral\">" + escapeHtml(title) + "</div>" + (bodyIsHtml ? "<div class=\"skinin-modal-list\">" + body + "</div>" : "<div class=\"skinin-modal-message\">" + escapeHtml(body) + "</div>") + "</div>";
        overlay.addEventListener("click", function (event) {
          if (event.target === overlay || event.target.closest(".skinin-modal-close")) overlay.remove();
        });
        document.body.appendChild(overlay);
      }

      function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, function (character) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" }[character];
        });
      }
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Ingredient checker",
  "target": "section",
  "stylesheet": "skinin-ingredient-checker.css",
  "javascript": "skinin-ingredient-checker.js",
  "settings": [
    {
      "type": "url",
      "id": "app_url",
      "label": "App backend URL"
    }
  ]
}
{% endschema %}
